# Telegram Bot Token (получить у @BotFather: https://t.me/BotFather)
BOT_TOKEN=123456:ABC-DEF...

# Telegram ID администратора (доступ в админ-панель)
ADMIN_ID=5434264152

# Базовый URL публичного каталога TGDen (менять не нужно)
TGDEN_BASE_URL=https://tgden.com

# Лимит поиска: N поисков за WINDOW секунд на пользователя
SEARCH_LIMIT=3
SEARCH_WINDOW=60

# Сколько объектов на страницу результатов в сообщении
RESULT_PAGE_SIZE=5

# Сколько страниц внешнего каталога подтягивать за один поиск
FETCH_PAGES=1

# Логирование в файл: 1 - да, 0 - нет
LOG_TO_FILE=1